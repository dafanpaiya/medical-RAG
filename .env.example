# ==============================================================================
# Enterprise Life Sciences & Pharmacopoeia RAG - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env
# Never commit the actual .env file to version control.

# ------------------------------------------------------------------------------
# Model Provider Configuration
# ------------------------------------------------------------------------------
# Optional Gemini API Key for LLM-based answer synthesis.
# If left empty, the engine automatically falls back to the local deterministic
# rule-based synthesizer with zero hallucination risk.
GEMINI_API_KEY=your_api_key_here

# ------------------------------------------------------------------------------
# HTTP Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Retrieval & RAG Pipeline Controls (Optional Overrides)
# ------------------------------------------------------------------------------
# Relevance score threshold for candidate retrieval (default: 0.40)
RAG_SCORE_THRESHOLD=0.40

# Query expansion mode: BASELINE, CONSERVATIVE, or LEGACY (default: BASELINE)
RAG_EXPANSION_MODE=BASELINE

# Path to unified knowledge base JSON candidate (optional, verified against SHA-256)
# UNIFIED_KB_PATH=data/staging/phase54_ocr_repair/unified_kb_candidate_phase54.json

# Optional isolated path for audit logging (defaults to data/audit_trail.jsonl)
# RAG_AUDIT_LOG_PATH=data/audit_trail.jsonl
